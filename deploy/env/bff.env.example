# /etc/socrate/bff.env — Socrate monitoring BFF
# Installed by bootstrap.sh as 0640 root:socrate-mon-bff — readable only by
# root and the BFF's own service user (P4-1).
#
# The BFF refuses to start without server-side sessions unless
# BFF_PHASE1_PASSTHROUGH=true is set explicitly. Phase 1 is an unauthenticated
# pass-through to the loopback-only admin API — never run it in production.

# Bind loopback — Caddy fronts it on monitoring.vandermoten.eu.
BFF_LISTEN_ADDR=127.0.0.1:8090

# Internal admin API (loopback). The BFF is its only client for this app.
BFF_ADMIN_UPSTREAM=http://127.0.0.1:8081

# ── Server-side sessions / token custody (REQUIRED) ──────────────────────────
# A CONFIDENTIAL OAuth client registered in Socrate; the secret lives only here.
BFF_OAUTH_UPSTREAM=http://127.0.0.1:8080
BFF_OAUTH_PUBLIC_URL=https://socrate.vandermoten.eu
BFF_PUBLIC_ORIGIN=https://monitoring.vandermoten.eu
BFF_CLIENT_ID=socrate-monitor
BFF_CLIENT_SECRET=CHANGE_ME
BFF_SCOPES=openid profile email
BFF_SESSION_IDLE=30m
BFF_SESSION_ABSOLUTE=8h
# Must stay true on an https origin (the BFF refuses false there).
BFF_COOKIE_SECURE=true

# Durable (multi-instance / restart-safe) session and pending-login stores
# (backendkit's bff.PostgresStore / bff.PostgresPendingLoginStore). Leave
# BFF_SESSION_DSN unset for the in-memory stores; BFF_SESSION_KEY is then not
# needed.
#
# Use the BFF's OWN Postgres role and database (P4-1): the session rows hold
# OAuth tokens, and the BFF must not be able to read Socrate's tables
# (users, clients, audit log) — nor Socrate the BFF's sessions. Create with:
#   sudo -u postgres createuser socrate_bff
#   sudo -u postgres createdb -O socrate_bff socrate_bff
#   sudo -u postgres psql -c "ALTER ROLE socrate_bff WITH PASSWORD '…';"
# then, as socrate_bff (the tables' owner), BEFORE starting the BFF:
#   psql "postgres://socrate_bff:…@127.0.0.1:5432/socrate_bff" -f deploy/sql/bff-session-store.sql
# BFF_SESSION_DSN=postgres://socrate_bff:CHANGE_ME@127.0.0.1:5432/socrate_bff?sslmode=disable
#
# REQUIRED with BFF_SESSION_DSN: the AES-256-GCM key that encrypts the rows,
# 32 random bytes in standard base64. Generate with `openssl rand -base64 32`.
# The BFF refuses to start without a valid one; changing it signs everyone out.
# BFF_SESSION_KEY=CHANGE_ME
#
# Who creates the tables: managed (default; deploy/sql/bff-session-store.sql,
# the BFF runs no DDL and checks the tables and grants at start-up) or auto
# (the BFF creates them; needs CREATE on the schema). Anything else refuses
# to start.
# BFF_SESSION_SCHEMA=managed

# ── Migration-only escape hatches (both are logged as WARNINGs at startup) ───
# BFF_PHASE1_PASSTHROUGH=true   # run with no sessions at all (BFF_CLIENT_ID unset)
# BFF_ALLOW_PASSTHROUGH=true    # forward session-less requests with their own bearer
