[Unit]
Description=Socrate Monitoring BFF (internal, fronts the admin API for the monitoring SPA)
Documentation=https://github.com/ovander/oauth2-monitoring
After=network-online.target socrate.service postgresql.service
Wants=network-online.target
# Phase 2+ uses Postgres for sessions; harmless to require it now.
Requires=socrate.service

[Service]
Type=simple
# P4-1: the BFF is the internet-facing parser and must not share an identity
# with the identity server. Its own user cannot read Socrate's signing keys,
# Socrate's env (SECRET_KEY_BASE, DATABASE_URL) or the admin BFF's secrets.
User=socrate-mon-bff
Group=socrate-mon-bff
EnvironmentFile=/etc/socrate/bff.env
ExecStart=/usr/local/bin/socrate-monitoring-bff
Restart=on-failure
RestartSec=5

# ── Hardening ────────────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
# Belt and braces on top of the dedicated user: even if the user split is
# undone by hand, these paths do not exist inside this unit's mount namespace.
InaccessiblePaths=-/var/lib/socrate -/etc/socrate/socrate.env -/etc/socrate/admin-bff.env

[Install]
WantedBy=multi-user.target
