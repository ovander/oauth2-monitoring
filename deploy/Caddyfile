# ─────────────────────────────────────────────────────────────────────────────
# Production Caddyfile — single VPS, vandermoten.eu
#
# Caddy is the ONLY public listener (ports 80/443). Everything else binds
# loopback and is fronted here:
#   socrate.vandermoten.eu     → OAuth 2.1 / OIDC server   (127.0.0.1:8080)
#   monitoring.vandermoten.eu  → monitoring SPA + BFF       (static + 127.0.0.1:8090)
#   admin.vandermoten.eu       → admin SPA + admin BFF      (own site file, see the end)
#   app-*.vandermoten.eu       → relying-party apps         (own site files)
#
# The admin API (127.0.0.1:8081) has NO public subdomain of its own — it is the
# Tier-0 control plane and is reachable only on-box, through the console BFFs.
# ─────────────────────────────────────────────────────────────────────────────

{
	email admin@vandermoten.eu
	# Automatic HTTPS via Let's Encrypt is on by default.
}

# Reusable security-header snippet.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}
}

# ── Socrate OAuth 2.1 / OIDC server (public endpoints: authorize, token, jwks) ──
socrate.vandermoten.eu {
	encode zstd gzip
	import security_headers
	reverse_proxy 127.0.0.1:8080
}

# ── Monitoring console: SPA static assets + internal BFF ───────────────────────
monitoring.vandermoten.eu {
	encode zstd gzip
	import security_headers
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"

	# Auth + admin API → the BFF (the only client of the admin API for this app).
	@bff path /bff/* /api/admin/*
	reverse_proxy @bff 127.0.0.1:8090 {
		flush_interval -1            # stream SSE (/api/admin/events/stream) immediately
		header_up X-Forwarded-Proto {scheme}
	}

	# Built monitoring SPA.
	handle {
		root * /srv/monitoring/dist
		try_files {path} /index.html
		file_server
	}
}

# ── Admin console (admin.vandermoten.eu) and any relying-party app ─────────────
# Each other public host lives in its own site file under /etc/caddy/sites/,
# installed by that project's deploy kit (oauth2-admin/deploy/Caddyfile routes
# /bff/*, /api/admin/*, /api/profile, /api/version and the password-reset posts
# to the admin BFF on 127.0.0.1:8091). The admin API on 127.0.0.1:8081 must
# NEVER be routed from a public host — only the console BFFs reach it, over
# loopback. The block that used to live here proxied admin.…/api/admin/* to
# :8081 directly (pre-BFF) and is gone.
import /etc/caddy/sites/*.caddy
