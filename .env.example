# Socrate monitoring console: SPA and Vite dev server settings.
#
# Copy to .env (or .env.local) for local development. Vite inlines every VITE_*
# value into the built JavaScript, so nothing secret belongs here. The SPA holds
# no OAuth client, URL or token: the BFF owns all of that, and its settings are
# documented in bff/README.md (production template: deploy/env/bff.env.example).

# ── Role-based access (read by src/stores/authStore.ts at build time) ─────────
# Comma-separated role names taken from the signed-in user's roles.
#
# VITE_ADMIN_ROLES   full access: alerts, blocked IPs, audit logs, settings.
#                    Grant only to operators who may act on incidents; never a
#                    generic end-user role such as "user".
# VITE_VIEWER_ROLES  read-only access: dashboard, events, threats, sessions,
#                    tokens, reports, geo, policy decisions.
#
# A user with neither sees the Unauthorised page.
VITE_ADMIN_ROLES=admin,monitor_admin
VITE_VIEWER_ROLES=monitor_viewer

# ── Vite dev server only (read by vite.config.ts; not part of the build) ──────
# Where `npm run dev` proxies /bff and /api: the locally running BFF.
DEV_BFF_TARGET=http://127.0.0.1:8090
